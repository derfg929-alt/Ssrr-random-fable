# Токен бота от @BotFather — обязателен
BOT_TOKEN=

# Где хранить данные (на хостинге укажите постоянный диск)
DATA_DIR=./data
DB_FILE=bot_data.json

# Кому доступны /backup и /restore (списки ID через запятую)
ADMIN_IDS=
ADMIN_USERNAME=

# Кому доступна команда «пользователи»
USERS_ADMIN_ID=

# Функции
CAPTCHA_ENABLED=1
REMINDERS_ENABLED=1
PIN_RESULTS=1
AUTO_DETECT_CHANNELS=1

# Хранилище и логи
JOURNAL_COMPACT_OPS=500
DB_FSYNC=1
LOG_LEVEL=INFO
LOG_FILE=
